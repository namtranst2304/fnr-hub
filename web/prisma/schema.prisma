// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------
// CHATBOT MODELS
// ----------------------------------------------------------------------

model Conversation {
  id        String    @id @default(uuid())
  title     String    @default("New Chat")
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // "user", "assistant", "system"
  content        String       @db.Text
  createdAt      DateTime     @default(now())
}

// ----------------------------------------------------------------------
// REPOSTING APP MODELS (For future features)
// ----------------------------------------------------------------------

model Article {
  id        String       @id @default(uuid())
  title     String
  content   String?      @db.Text
  status    String       @default("PENDING") // PENDING, PROCESSING, COMPLETED
  chapters  Chapter[]
  logs      ProcessLog[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Chapter {
  id                String   @id @default(uuid())
  articleId         String
  article           Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  chapterNumber     Int
  title             String?
  content           String   @db.Text
  translatedContent String?  @db.Text
  status            String   @default("PENDING") // PENDING, TRANSLATED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ProcessLog {
  id        String   @id @default(uuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  action    String   // e.g. "START_TRANSLATION", "CHAPTER_DIVIDED"
  message   String   @db.Text
  status    String   // "INFO", "ERROR", "SUCCESS"
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------
// FACEBOOK POSTING MODELS
// ----------------------------------------------------------------------

model Post {
  id             Int         @id @default(autoincrement())
  sourcePostId   String      @unique 
  originalText   String    
  rewrittenText  String?     // Content rewritten by AI
  
  // State transitions: REWRITTEN -> SCHEDULED -> POSTED
  status         String      @default("DRAFT") 
  
  // -- POST MANAGEMENT FIELDS --
  scheduledAt    DateTime?   // Scheduled time to post
  fbPostId       String?     // Facebook post ID (returned after successful schedule)
  
  // -- SOURCE LINK --
  sourcePageId   Int?
  sourcePage     SourcePage? @relation(fields: [sourcePageId], references: [id], onDelete: SetNull)
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// ----------------------------------------------------------------------
// AUTO-POSTING MODELS
// ----------------------------------------------------------------------

// Facebook source for auto-scrape
model SourcePage {
  id          Int       @id @default(autoincrement())
  url         String    @unique   // URL page/profile FB
  name        String               // Display name (e.g. "TechCrunch")
  isActive    Boolean   @default(true) // Toggle auto-scrape
  interval    Int       @default(30)   // Scrape interval in minutes
  lastScraped DateTime?
  posts       Post[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Auto Post configuration (singleton — only 1 row)
model AutoPostConfig {
  id              Int     @id @default(1)
  autoScrapeOn    Boolean @default(false)
  autoPostOn      Boolean @default(false)
  postIntervalMin   Int       @default(120)  // Post interval in minutes
  scrapeIntervalMin Int       @default(30)   // Scrape interval in minutes
  aiPromptRules     String?   @db.Text       // AI prompt generator rules
  updatedAt         DateTime  @updatedAt
}
