// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------
// CHATBOT MODELS
// ----------------------------------------------------------------------

model Conversation {
  id        String    @id @default(uuid())
  title     String    @default("New Chat")
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // "user", "assistant", "system"
  content        String       @db.Text
  createdAt      DateTime     @default(now())
}

// ----------------------------------------------------------------------
// REPOSTING APP MODELS (For future features)
// ----------------------------------------------------------------------

model Article {
  id        String       @id @default(uuid())
  title     String
  content   String?      @db.Text
  status    String       @default("PENDING") // PENDING, PROCESSING, COMPLETED
  chapters  Chapter[]
  logs      ProcessLog[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Chapter {
  id                String   @id @default(uuid())
  articleId         String
  article           Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  chapterNumber     Int
  title             String?
  content           String   @db.Text
  translatedContent String?  @db.Text
  status            String   @default("PENDING") // PENDING, TRANSLATED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ProcessLog {
  id        String   @id @default(uuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  action    String   // e.g. "START_TRANSLATION", "CHAPTER_DIVIDED"
  message   String   @db.Text
  status    String   // "INFO", "ERROR", "SUCCESS"
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------
// FACEBOOK POSTING MODELS
// ----------------------------------------------------------------------

model Post {
  id             Int         @id @default(autoincrement())
  sourcePostId   String      @unique 
  originalText   String    
  rewrittenText  String?     // Nội dung đã được AI xào xong
  
  // Trạng thái sẽ đi từ: REWRITTEN -> SCHEDULED -> POSTED
  status         String      @default("DRAFT") 
  
  // -- CÁC TRƯỜNG QUẢN LÝ ĐĂNG BÀI --
  scheduledAt    DateTime?   // Thời gian bạn hẹn giờ đăng
  fbPostId       String?     // ID bài viết trên Facebook (trả về sau khi hẹn thành công)
  
  // -- LIÊN KẾT NGUỒN --
  sourcePageId   Int?
  sourcePage     SourcePage? @relation(fields: [sourcePageId], references: [id], onDelete: SetNull)
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// ----------------------------------------------------------------------
// AUTO-POSTING MODELS
// ----------------------------------------------------------------------

// Nguồn Facebook để auto-scrape
model SourcePage {
  id          Int       @id @default(autoincrement())
  url         String    @unique   // URL page/profile FB
  name        String               // Tên hiển thị (VD: "TechCrunch VN")
  isActive    Boolean   @default(true) // Bật/tắt auto-scrape
  interval    Int       @default(30)   // Scrape mỗi bao nhiêu phút
  lastScraped DateTime?
  posts       Post[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Cấu hình Auto Post (singleton — chỉ 1 row)
model AutoPostConfig {
  id              Int     @id @default(1)
  autoScrapeOn    Boolean @default(false)
  autoPostOn      Boolean @default(false)
  postIntervalMin Int     @default(120)  // Đăng mỗi bao nhiêu phút
  scrapeIntervalMin Int   @default(30)   // Cào mỗi bao nhiêu phút
  updatedAt       DateTime @updatedAt
}
