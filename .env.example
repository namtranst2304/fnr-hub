# ==========================================
# FNR Hub - Environment Variables Template
# ==========================================

# 1. Frontend Settings (Next.js - put this inside web/.env)
# DATABASE_URL="postgresql://user:password@localhost:5432/fnr"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Server-side API URL (for SSR/Docker - if backend is on a different host)
# API_URL="http://backend:8000"

# 2. Backend Settings (FastAPI - put this inside api/.env)
DATABASE_URL="postgresql://admin:secretpassword@db:5432/automation_db?schema=public"
GEMINI_API_KEY=""
FACEBOOK_PAGE_ID=""
FACEBOOK_ACCESS_TOKEN=""

# 3. CORS Origins (comma-separated, for production)
# CORS_ORIGINS="http://localhost:3000,https://yourdomain.com"
